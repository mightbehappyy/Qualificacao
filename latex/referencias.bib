@article{carvalhoDynamicSelectionEnsemblebased2025,
  title = {Dynamic Selection of Ensemble-Based Regression Models: {{Systematic}} Literature Review},
  shorttitle = {Dynamic Selection of Ensemble-Based Regression Models},
  author = {Carvalho, Halcyon Davys P. De and Oliveira, Jo{\~a}o Fausto L. De and Fagundes, Roberta Andrade De A.},
  year = 2025,
  month = sep,
  journal = {Expert Systems with Applications},
  volume = {290},
  pages = {128429},
  issn = {09574174},
  doi = {10.1016/j.eswa.2025.128429},
  urldate = {2026-10-30},
  abstract = {Dynamic selection techniques have emerged as a promising approach to enhance ensemble-based regression methods, offering adaptive solutions for dynamic and heterogeneous data. This study presents a comprehensive Systematic Literature Review (SLR) on dynamic selection in regression models, aiming to investigate how these techniques can improve predictive effectiveness across various contexts. The review encompassed 21 primary empirical studies published between 2015 and 2024, addressing six research questions (RQs) covering models used, evaluation metrics, implementation strategies, and performance criteria. The findings highlight the use of 59 distinct models and 26 evaluation metrics, such as RMSE, MAE, and {$R$}2, applied across 144 datasets from domains including healthcare, energy, finance, and time series forecasting. Four main categories of dynamic selection techniques were identified: Dynamic Selection (DS), Dynamic Weighting (DW), Dynamic Weighting with Selection (DWS), and Optimization-Based Methods. These approaches demonstrated significant improvements in accuracy, robustness, and scalability, particularly in scenarios involving noise, data imbalance, and concept drift. However, challenges such as high computational costs and the lack of unified evaluation frameworks remain. This study provides a consolidated foundation for researchers and practitioners seeking to explore and apply dynamic selection techniques, highlighting promising avenues for future research, including integration with deep learning and distributed systems.},
  langid = {english},
  file = {/home/juniper/Documents/Qualificacao/assets/Papers/Carvalho et al. - 2025 - Dynamic selection of ensemble-based regression models Systematic literature review.pdf}
}

@article{cerqueiraArbitrageForecastingExperts2019a,
  title = {Arbitrage of Forecasting Experts},
  author = {Cerqueira, Vitor and Torgo, Lu{\'i}s and Pinto, F{\'a}bio and Soares, Carlos},
  year = 2019,
  month = jun,
  journal = {Machine Learning},
  volume = {108},
  number = {6},
  pages = {913--944},
  issn = {0885-6125, 1573-0565},
  doi = {10.1007/s10994-018-05774-y},
  urldate = {2026-11-25},
  abstract = {Forecasting is an important task across several domains. Its generalised interest is related to the uncertainty and complex evolving structure of time series. Forecasting methods are typically designed to cope with temporal dependencies among observations, but it is widely accepted that none is universally applicable. Therefore, a common solution to these tasks is to combine the opinion of a diverse set of forecasts. In this paper we present an approach based on arbitrating, in which several forecasting models are dynamically combined to obtain predictions. Arbitrating is a metalearning approach that combines the output of experts according to predictions of the loss that they will incur. We present an approach for retrieving out-of-bag predictions that significantly improves its data efficiency. Finally, since diversity is a fundamental component in ensemble methods, we propose a method for explicitly handling the inter-dependence between experts when aggregating their predictions. Results from extensive empirical experiments provide evidence of the method's competitiveness relative to state of the art approaches. The proposed method is publicly available in a software package.},
  langid = {english},
  file = {/home/juniper/Documents/Qualificacao/assets/Papers/Cerqueira et al. - 2019 - Arbitrage of forecasting experts_1.pdf;/home/juniper/Zotero/storage/GTI4ZQVQ/Cerqueira et al. - 2019 - Arbitrage of forecasting experts.pdf}
}

@inproceedings{cerqueiraDynamicHeterogeneousEnsembles2017,
  title = {Dynamic and {{Heterogeneous Ensembles}} for {{Time Series Forecasting}}},
  booktitle = {2017 {{IEEE International Conference}} on {{Data Science}} and {{Advanced Analytics}} ({{DSAA}})},
  author = {Cerqueira, Vitor and Torgo, Luis and Oliveira, Mariana and Pfahringer, Bernhard},
  year = 2017,
  month = oct,
  pages = {242--251},
  publisher = {IEEE},
  address = {Tokyo, Japan},
  doi = {10.1109/DSAA.2017.26},
  urldate = {2026-11-04},
  abstract = {This paper addresses the issue of learning time series forecasting models in changing environments by leveraging the predictive power of ensemble methods. Concept drift adaptation is performed in an active manner, by dynamically combining base learners according to their recent performance using a non-linear function. Diversity in the ensembles is encouraged with several strategies that include heterogeneity among learners, sampling techniques and computation of summary statistics as extra predictors. Heterogeneity is used with the goal of better coping with different dynamic regimes of the time series. The driving hypotheses of this work are that (i) heterogeneous ensembles should better fit different dynamic regimes and (ii) dynamic aggregation should allow for fast detection and adaptation to regime changes. We extend some strategies typically used in classification tasks to time series forecasting. The proposed methods are validated using Monte Carlo simulations on 16 realworld univariate time series with numerical outcome as well as an artificial series with clear regime shifts. The results provide strong empirical evidence for our hypotheses. To encourage reproducibility the proposed method is publicly available as a software package.},
  isbn = {978-1-5090-5004-8},
  langid = {english},
  file = {/home/juniper/Documents/Qualificacao/assets/Papers/Cerqueira et al. - 2017 - Dynamic and Heterogeneous Ensembles for Time Series Forecasting.pdf}
}

@article{cruzDynamicClassifierSelection2018,
  title = {Dynamic Classifier Selection: {{Recent}} Advances and Perspectives},
  shorttitle = {Dynamic Classifier Selection},
  author = {Cruz, Rafael M.O. and Sabourin, Robert and Cavalcanti, George D.C.},
  year = 2018,
  month = may,
  journal = {Information Fusion},
  volume = {41},
  pages = {195--216},
  issn = {15662535},
  doi = {10.1016/j.inffus.2017.09.010},
  urldate = {2026-11-13},
  abstract = {Multiple Classifier Systems (MCS) have been widely studied as an alternative for increasing accuracy in pattern recognition. One of the most promising MCS approaches is Dynamic Selection (DS), in which the base classifiers are selected on the fly, according to each new sample to be classified. This paper provides a review of the DS techniques proposed in the literature from a theoretical and empirical point of view. We propose an updated taxonomy based on the main characteristics found in a dynamic selection system: (1) The methodology used to define a local region for the estimation of the local competence of the base classifiers; (2) The source of information used to estimate the level of competence of the base classifiers, such as local accuracy, oracle, ranking and probabilistic models, and (3) The selection approach, which determines whether a single or an ensemble of classifiers is selected. We categorize the main dynamic selection techniques in the DS literature based on the proposed taxonomy. We also conduct an extensive experimental analysis, considering a total of 18 state-of-the-art dynamic selection techniques, as well as static ensemble combination and single classification models. To date, this is the first analysis comparing all the key DS techniques under the same experimental protocol. Furthermore, we also present several perspectives and open research questions that can be used as a guide for future works in this domain.},
  langid = {english},
  file = {/home/juniper/Documents/Qualificacao/assets/Papers/Cruz et al. - 2018 - Dynamic classifier selection Recent advances and perspectives.pdf}
}

