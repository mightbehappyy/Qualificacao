@article{carvalhoDynamicSelectionEnsemblebased2025,
  title = {Dynamic Selection of Ensemble-Based Regression Models: {{Systematic}} Literature Review},
  shorttitle = {Dynamic Selection of Ensemble-Based Regression Models},
  author = {Carvalho, Halcyon Davys P. De and Oliveira, Jo{\~a}o Fausto L. De and Fagundes, Roberta Andrade De A.},
  year = 2025,
  month = sep,
  journal = {Expert Systems with Applications},
  volume = {290},
  pages = {128429},
  issn = {09574174},
  doi = {10.1016/j.eswa.2025.128429},
  urldate = {2026-10-30},
  abstract = {Dynamic selection techniques have emerged as a promising approach to enhance ensemble-based regression methods, offering adaptive solutions for dynamic and heterogeneous data. This study presents a comprehensive Systematic Literature Review (SLR) on dynamic selection in regression models, aiming to investigate how these techniques can improve predictive effectiveness across various contexts. The review encompassed 21 primary empirical studies published between 2015 and 2024, addressing six research questions (RQs) covering models used, evaluation metrics, implementation strategies, and performance criteria. The findings highlight the use of 59 distinct models and 26 evaluation metrics, such as RMSE, MAE, and {$R$}2, applied across 144 datasets from domains including healthcare, energy, finance, and time series forecasting. Four main categories of dynamic selection techniques were identified: Dynamic Selection (DS), Dynamic Weighting (DW), Dynamic Weighting with Selection (DWS), and Optimization-Based Methods. These approaches demonstrated significant improvements in accuracy, robustness, and scalability, particularly in scenarios involving noise, data imbalance, and concept drift. However, challenges such as high computational costs and the lack of unified evaluation frameworks remain. This study provides a consolidated foundation for researchers and practitioners seeking to explore and apply dynamic selection techniques, highlighting promising avenues for future research, including integration with deep learning and distributed systems.},
  langid = {english},
  file = {/home/juniper/Documents/Qualificacao/assets/Papers/Carvalho et al. - 2025 - Dynamic selection of ensemble-based regression models Systematic literature review.pdf}
}

